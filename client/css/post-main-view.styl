@import colors

.post-view
    width: 100%
    display: flex !important
    flex-direction: row

    >.sidebar
        margin-right: 1em
        min-width: 21em
        max-width: 21em
        line-height: 160%

        a:active
            border: 0
            outline: 0

    >.sidebar>nav.buttons, >.content nav.buttons
        margin-top: 0
        display: flex
        flex-wrap: wrap
        article
            flex: 1 0 33%
            a
                display: inline-block
                width: 100%
                padding: 0.3em 0
                text-align: center
                vertical-align: middle
                transition: background 0.2s linear, box-shadow 0.2s linear
                &:not(.inactive):hover
                    background: lighten($main-color, 90%)
            i
                font-size: 140%
            text-align: center
        @media (max-width: 800px)
            margin-top: 0.6em
            margin-bottom: 0.6em

    >.content
        width: 100%

    .post-container-wrap
        display: flex
        flex-direction: row
        align-items: stretch
        margin-bottom: 0.6em

        .stack-side-panel
            flex: 0 0 5em
            position: relative
            background-size: cover
            background-position: center
            cursor: pointer
            opacity: 0.45
            transition: opacity 0.2s, flex-basis 0.2s
            border-radius: 3px
            overflow: hidden
            display: flex
            align-items: center
            justify-content: center
            min-height: 8em
            flex-grow: 0

            &:not(.disabled):hover
                opacity: 0.75
                flex-basis: 7em

            &.disabled
                opacity: 0.08
                cursor: default
                background: rgba(128, 128, 128, 0.15)

            &::after
                content: ''
                position: absolute
                inset: 0
                background: rgba(0, 0, 0, 0.35)
                pointer-events: none

            i
                position: relative
                z-index: 1
                font-size: 1.8em
                color: white
                text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8)

            &.stack-side-prev
                margin-right: 0.4em
            &.stack-side-next
                margin-left: 0.4em

    .post-container
        flex: 1
        min-width: 0

        .post-content
            margin: 0

    .after-mobile-controls
        width: 100%

.darktheme .post-view
    >.sidebar, >.content
        nav.buttons
            article
                a:not(.inactive):hover
                    background: unset
                    box-shadow: inset 0 0 0 0.3em $main-color

@media (max-width: 800px)
    .post-view
        flex-wrap: wrap
        >.after-mobile-controls
            order: 3
        >.sidebar
            order: 2
            min-width: 100%
            max-width: 0
            margin-right: 0
        >.content
            order: 1

    .post-container-wrap
        flex-wrap: wrap
        row-gap: 0.4em
        .post-container
            order: 1
            flex: 0 0 100%
        .stack-side-panel
            order: 2
            flex: 1
            flex-grow: 1 !important
            min-height: 3.5em
            &.stack-side-prev
                margin-right: 0.2em
            &.stack-side-next
                margin-left: 0.2em


.post-view .readonly-sidebar
    .details
        i
            margin-right: 0.6em
            display: inline-block
            width: 1em
            text-align: center

        .safety-safe
            color: $safety-safe
        .safety-sketchy
            color: $safety-sketchy
        .safety-unsafe
            color: $safety-unsafe

        .upload-info
            .thumbnail
                width: 1em
                height: 1em
                margin: -0.1em 0.6em 0 0

        .zoom
            margin-top: 1em
            a
                display: inline-block
            .active
                text-decoration: underline

        .social
            margin-top: 1em
            .score-container
                float: left
                margin-right: 3em
                .downvote i
                    text-align: right
            i
                text-align: left
                margin: 0
            .value
                text-align: center
                display: inline-block
                width: 2em

    .stack-carousel
        margin-top: 2em
        h1
            margin-bottom: 0.5em

        .stack-carousel-strip
            display: flex
            overflow-x: auto
            gap: 0.3em
            padding-bottom: 0.3em
            scrollbar-width: thin

            .stack-carousel-item
                flex: 0 0 auto
                width: 4em
                height: 3em
                display: block
                outline-offset: -2px
                opacity: 0.65
                transition: opacity 0.15s
                &:hover
                    opacity: 0.9
                &.active
                    opacity: 1
                    outline: 2px solid $main-color
                .thumbnail
                    width: 4em
                    height: 3em
                    background-position: 50% 30%

        .stack-carousel-nav
            display: flex
            align-items: center
            gap: 0.5em
            margin-top: 0.4em
            font-size: 90%

            a, span
                display: inline-flex
                align-items: center
                justify-content: center
                width: 1.8em
                height: 1.8em
            span.disabled
                opacity: 0.3
                cursor: default
            .stack-pos
                width: auto
                flex: 1
                text-align: center
                font-size: 85%
                opacity: 0.75

    .relations
        margin-top: 2em
        h1
            margin-bottom: 0.5em
        .thumbnail
            width: 4em
            height: 3em
            background-position: 50% 30%
        li
            margin: 0 0.3em 0.3em 0
            display: inline-block

    .tags
        margin-top: 2em
        h1
            margin-bottom: 0.5em

.post-view .edit-sidebar
    .expander-content
        section:not(:last-child)
            margin-bottom: 1em

    .safety
        &>label
            width: 100%
        .radio-wrapper
            display: flex
            flex-wrap: wrap
        .radio-wrapper label
            flex-grow: 1
            display: inline-block

    .management
        ul
            list-style-type: none
            margin: 0
            padding: 0
            li
                margin: 0
                padding: 0

    .post-source
        textarea
            white-space: pre
            overflow-wrap: normal
            overflow-x: scroll

    form
        width: auto

    label:not(.file-dropper)
        margin-bottom: 0.3em
        display: block

    input[type=submit],
    input[type=button],
    button
        width: 100%
        &:focus
            border: 2px solid $text-color !important

    .messages
        margin-top: 1em
